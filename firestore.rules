rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'tdesmond12@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function validVisibility(v) { return v in ['public', 'private']; }
    // The credit to the original creator can't be edited after the recipe is created.
    function creditUnchanged() {
      return request.resource.data.get('sourceName', null) == resource.data.get('sourceName', null)
          && request.resource.data.get('sourceUrl', null) == resource.data.get('sourceUrl', null)
          && request.resource.data.get('sourceNote', null) == resource.data.get('sourceNote', null)
          && request.resource.data.get('importedFrom', null) == resource.data.get('importedFrom', null);
    }
    function validRecipe(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 150
        && d.ingredients is list && d.ingredients.size() <= 100
        && d.steps is list && d.steps.size() <= 100
        && validVisibility(d.visibility)
        && (!('ingKeys' in d) || (d.ingKeys is list && d.ingKeys.size() <= 150));
    }

    // Shared lists: everyone can read, only the admin can change.
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tools/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Each user's own kitchen and custom categories.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Recipes: public ones are readable by anyone, private ones only by the owner.
    match /recipes/{id} {
      allow read: if resource.data.visibility == 'public'
                  || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && validRecipe(request.resource.data);
      allow update: if signedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    && creditUnchanged()
                    && validRecipe(request.resource.data);
      // Owners can delete their own recipes; the admin can remove any recipe (e.g. after a report).
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Directory: lets a signed-in user look up another signed-up user by email (one at a time, no listing).
    // Only the account owner can create or change their own entry, and only with a verified email.
    match /directory/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
                    && request.auth.token.email_verified == true
                    && email == request.auth.token.email.lower()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'displayName', 'updatedAt'])
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() <= 80;
      allow update: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && request.auth.token.email_verified == true
                    && email == request.auth.token.email.lower()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'displayName', 'updatedAt'])
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() <= 80;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Messages: a recipe sent from one signed-up user to another.
    function validMessage(d) {
      return d.keys().hasOnly(['fromUid', 'fromName', 'toUid', 'toName', 'note', 'recipe', 'createdAt', 'read', 'savedAs'])
        && d.fromName is string && d.fromName.size() <= 80
        && d.toName is string && d.toName.size() <= 80
        && d.note is string && d.note.size() <= 300
        && d.read == false
        && d.createdAt is int
        && d.recipe is map
        && d.recipe.title is string && d.recipe.title.size() > 0 && d.recipe.title.size() <= 150
        && d.recipe.ingredients is list && d.recipe.ingredients.size() <= 100
        && d.recipe.steps is list && d.recipe.steps.size() <= 100;
    }
    match /messages/{id} {
      allow create: if signedIn()
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid is string
                    && request.resource.data.toUid != request.auth.uid
                    && exists(/databases/$(database)/documents/users/$(request.resource.data.toUid))
                    && !(request.auth.uid in get(/databases/$(database)/documents/users/$(request.resource.data.toUid)).data.get('blocked', []))
                    && validMessage(request.resource.data);
      allow read: if signedIn()
                  && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      // The receiver can only mark it read or record which recipe they saved.
      allow update: if signedIn()
                    && resource.data.toUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'savedAs']);
      allow delete: if signedIn()
                    && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
    }

    // Reports: any signed-in user can report a message or a public recipe, once each.
    // The report's id must be "<reporterUid>_<messageId or recipeId>", so a second report from the same person is rejected.
    // Only the admin can read, dismiss or delete reports.
    function reportTarget(d) { return d.get('recipeId', d.get('messageId', '')); }
    function validReport(d) {
      return d.keys().hasOnly(['kind', 'reporterUid', 'reporterName', 'reportedUid', 'reportedName', 'messageId', 'recipeId', 'reason', 'details', 'note', 'recipe', 'createdAt'])
        && d.kind in ['message', 'recipe']
        && d.reporterUid == request.auth.uid
        && d.reason in ['language', 'spam', 'harass', 'other']
        && d.details is string && d.details.size() <= 300
        && d.note is string && d.note.size() <= 300
        && d.reportedUid is string
        && d.recipe is map
        && d.createdAt is int
        && reportTarget(d) is string && reportTarget(d).size() > 0
        && (d.kind != 'recipe'
            || (d.reportedUid != request.auth.uid
                && exists(/databases/$(database)/documents/recipes/$(d.recipeId))
                && get(/databases/$(database)/documents/recipes/$(d.recipeId)).data.visibility == 'public'
                && get(/databases/$(database)/documents/recipes/$(d.recipeId)).data.ownerId == d.reportedUid));
    }
    match /reports/{id} {
      allow create: if signedIn()
                    && id == request.auth.uid + '_' + reportTarget(request.resource.data)
                    && validReport(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in ['dismissed', 'removed'];
    }
  }
}
